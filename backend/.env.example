# Server
PORT=3000
NODE_ENV=development

# Neon PostgreSQL
DATABASE_URL=
# Optional separate PostgreSQL database for integration tests. Never production.
TEST_DATABASE_URL=

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Add { "aud": "soundshare-api" } in Clerk Sessions > Customize session token.
CLERK_AUDIENCE=soundshare-api
# Optional comma-separated web origins; configure when serving browser clients.
CLERK_AUTHORIZED_PARTIES=
# Optional PEM public key for networkless verification (otherwise use Clerk JWKS).
CLERK_JWT_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
