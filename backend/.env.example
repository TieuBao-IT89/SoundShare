# Server
PORT=3000
NODE_ENV=development
# 0 for direct/local requests; 1 only behind Render's ingress proxy.
TRUST_PROXY_HOPS=0
# Optional public build value. Empty uses the browser origin when serving Web.
WEB_API_BASE_URL=
# Optional best-effort self-ping; only runs in production when explicitly enabled.
KEEP_ALIVE_ENABLED=false
# Public HTTPS backend origin only, without /api, query, or credentials.
API_URL=

# Neon PostgreSQL
DATABASE_URL=
# Optional separate PostgreSQL database for integration tests. Never production.
TEST_DATABASE_URL=

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Add { "aud": "soundshare-api" } in Clerk Sessions > Customize session token.
CLERK_AUDIENCE=soundshare-api
# Optional comma-separated web origins; configure when serving browser clients.
CLERK_AUTHORIZED_PARTIES=
# Optional PEM public key for networkless verification (otherwise use Clerk JWKS).
CLERK_JWT_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
